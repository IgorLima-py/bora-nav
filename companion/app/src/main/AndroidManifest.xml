<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!--
        C13a: the navigation service is `specialUse`. C13b: also `location`, when it starts with the
        app on screen, so the phone's GPS backs up the watch's (see NavForegroundService).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (API 30+): without this the SDK cannot see Garmin Connect Mobile. -->
    <queries>
        <package android:name="com.garmin.android.apps.connectmobile" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.MotoNav">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            "Share -> MotoNav" from Google Maps / Waze (RF-01).

            Empty taskAffinity + excludeFromRecents: this screen is transient,
            lives for one share and dies. Without it, it entered MotoNav's task
            stack and the app showed up **twice** in the list of open
            windows (reported by Igor on 2026-07-31).
        -->
        <activity
            android:name=".share.ShareReceiverActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <!--
            C13a: holds the process, the network and the CPU while the watch navigates. The subtype is
            free text for store review, which this app does not have (sideload).
        -->
        <service
            android:name=".nav.NavForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the link to the Garmin watch: answers the favorite requested on the watch and, while navigating, recalculates the route and updates the arrival time" />
        </service>

    </application>

</manifest>
