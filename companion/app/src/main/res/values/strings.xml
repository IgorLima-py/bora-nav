    <string name="set_corridor_pct_hint">The gray of the streets around the route.</string>
    <string name="set_hud_pct">Overall size</string>
    <string name="set_hud_pct_hint">Makes everything bigger or smaller at once, on top of each part\'s setting.</string>
    <string name="set_orbit_px">Shift against screen burn-in</string>
    <string name="set_orbit_px_hint">The HUD slowly moves a few pixels so it doesn\'t mark the panel. 0 turns it off.</string>
    <string name="set_orbit_s">Time at each position</string>
    <string name="set_orbit_s_hint">How long the HUD stays at each point of the shift.</string>
    <string name="set_dist_pct">Distance to the turn</string>
    <string name="set_dist_pct_hint">The big number and its unit (m, km).</string>
    <string name="set_eta_pct">Arrival time</string>
    <string name="set_eta_pct_hint">At the bottom of the screen.</string>
    <string name="set_text_pct">Text</string>
    <string name="set_text_pct_hint">Clock, street name, distance left and the “then”.</string>
    <string name="set_arrow_pct">Arrow</string>
    <string name="set_arrow_pct_hint">The maneuver arrow and the arrival check.</string>
    <string name="set_plate_w_pct">Sign padding at the sides</string>
    <string name="set_plate_w_pct_hint">Space between the text and the frame. The letters don\'t change.</string>
    <string name="set_plate_h_pct">Sign padding at top and bottom</string>
    <string name="set_plate_h_pct_hint">0%% is a tight sign. The letters don\'t change.</string>
    <string name="set_gps_drill_min">GPS gap</string>
    <string name="set_gps_drill_min_hint">On each trip, this many minutes after leaving, the watch fakes 90 s without GPS and uses the phone\'s, to prove the handover and the return. For the phone to give its position, open the app on it once before leaving. 0 turns it off.</string>
    <string name="set_street_img">Streets as an image</string>
    <string name="set_street_img_hint">On, the streets are drawn once into an image. Off, street by street every frame.</string>
    <string name="set_map_tilt">Tilted map</string>
    <string name="set_map_tilt_hint">The map flattened around the bike. Off, the map stays flat.</string>
    <string name="set_street_16bit">16-bit image</string>
    <string name="set_street_16bit_hint">Off, the image takes twice the memory and the tilted map may fall back to flat.</string>
    <string name="set_street_diag">Street diagnostics</string>
    <string name="set_street_diag_hint">One lever at a time, with “Tilted map” off. Pick one, wait about 10 seconds with the route on the map and see whether the streets show up; the watch shows “D” and the number to the left of the bike. On the probes (4 to 7), count how many colored X appear. On the grids (8 to 10), ride a bit and see whether the streets follow. Needs watch v1.2.9. Go back to Normal after the test.</string>
    <string name="set_vibe_on">Buzz on the wrist</string>
    <string name="set_vibe_on_hint">Before each turn (2 buzzes for left, 3 for right), on arrival and when you leave the route. The settings below are only felt with this on. Needs watch v1.2.7.</string>
    <string name="set_radar_vibe">Buzz for speed cameras</string>
    <string name="set_radar_vibe_hint">One buzz when the camera sign shows up, once per camera. Works even with “Buzz on the wrist” off. Needs watch v1.2.9.</string>

