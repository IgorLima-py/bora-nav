    <string name="set_lead_min_m_hint">When slow, the alert comes at least this far from the turn.</string>
    <string name="set_near_m">Second alert, right at the turn</string>
    <string name="set_near_m_hint">At this distance comes the “now” alert. It must be shorter than the one above.</string>
    <string name="set_pulse_ms">Length of each buzz</string>
    <string name="set_pulse_ms_hint">The short buzz of a turn; the long buzz is twice as long.</string>
    <string name="set_zoom">Zoom when the route opens</string>
