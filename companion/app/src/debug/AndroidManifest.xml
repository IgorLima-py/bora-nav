<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug build only (C5): the receiver for wireless fine-tuning, triggered by
    `adb shell am broadcast` (see ConfigReceiver.kt). Exported because `adb`
    is another process; the release APK does not have this component.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".debug.ConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.igor.motonav.debug.CONFIG" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
