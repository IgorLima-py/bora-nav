<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!--
        MotoNav watch app. The application id below is a fixed UUID: the companion
        app references the very same value (see companion MotoNavIds.WATCH_APP_UUID
        and docs/DECISIONS.md). Never regenerate it.
    -->
    <iq:application id="2c29817b21c0413583b3e4f4e2d253dd"
                   type="watch-app"
                   name="@Strings.AppName"
                   entry="MotoNavApp"
                   launcherIcon="@Drawables.LauncherIcon"
                   minApiLevel="5.0.0">

        <!--
            Every round AMOLED watch of 390 px and up with API 5 (C16.12, Igor's choice): the layout is
            written in px of the Venu 4 45 mm and scaled by `Screen`. Only the venu445mm was ridden.
