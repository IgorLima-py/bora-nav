import Toybox.Lang;
import Toybox.Test;

//! **Favorites** (C12, `05 §FAVORITES` and `§NAV_START_REQ`).
//!
//! The bytes come from `TestVectors`, generated by `tools/gen_watch_test_vectors.py`;
//! the `FAVORITES` there is **`tools/fixtures/favorites_00.bin` itself**, the same
//! file the Kotlin `favoritesMatchFixture` compares the packer against, and
//! `NAV_START_REQ` is `nav_start_req_00.bin`. Public places only.
//!
//! Every test enters and leaves with the list empty and without writing to `Storage`
//! (`persistFavorites = false`): the simulator `Storage` survives between
//! runs (measured in C5), and a list forgotten here would show up on the favorites
//! screen of the next `sim.py demo`.
(:test)
module FavoritesAssert {

    function assembler(link as FakeLink) as MessageAssembler {
        Favorites.reset(false);
        Diag.clear();
        var assembler = new MessageAssembler(new RouteModel(), link);
        assembler.persistFavorites = false;
        return assembler;
    }

    function logged(text as String) as Boolean {
        for (var i = 0; i < Diag.lines.size(); i++) {
            if ((Diag.lines[i] as String).find(text) != null) {
                return true;
            }
        }
        return false;
    }

    function done() as Void {
        Favorites.reset(false);
        Diag.clear();
    }

    //! The list that the packer `FAVORITES_SAMPLE` describes, item by item.
    function assertIsTheFixture() as Void {
        Test.assertEqualMessage(Favorites.count(), TestVectors.FAV_COUNT, "how many");
        for (var i = 0; i < TestVectors.FAV_COUNT; i++) {
            var label = "item " + i.toString();
            Test.assertEqualMessage(Favorites.ids[i], TestVectors.FAV_IDS[i], label + " favId");
            Test.assertEqualMessage(Favorites.latE5[i], TestVectors.FAV_LATS[i], label + " lat");
            Test.assertEqualMessage(Favorites.lonE5[i], TestVectors.FAV_LONS[i], label + " lon");
            Test.assertEqualMessage(Favorites.icons[i], TestVectors.FAV_ICONS[i], label + " icon");
            Test.assertEqualMessage(Favorites.names[i], TestVectors.FAV_NAMES[i], label + " name");
        }
    }
}

//! The tests live inside `FavoritesTest` (not loose, like `ConfigTest`'s)
//! because `parsesTheFixture` is already a global function name in `ConfigTest`, and the C12
//! `verificar:` asks for `FavoritesTest.parsesTheFixture`.
(:test)
module FavoritesTest {

    //! The packer.py `favorites_00.bin` becomes the list, **with no route at all on the watch**
    //! (outside the route/META check), with an ACK of type 0x05, no transfer screen
    //! (`lastWasFavorites`) and without touching the route statistics.
    // prevents: the watch reading the coordinate or the name from the wrong offset (sign, field order,
    // out-of-order id), listing garbage or navigating somewhere other than the chosen one.
    (:test)
    function parsesTheFixture(logger as Logger) as Boolean {
        var link = new FakeLink();
        var assembler = FavoritesAssert.assembler(link);

        assembler.onData(TestVectors.FAVORITES);

        Test.assertMessage(assembler.lastWasFavorites, "the app needs to know it was FAVORITES");
        FavoritesAssert.assertIsTheFixture();
        Test.assertEqualMessage(link.ackCount, 1, "one ACK");
        Test.assertEqualMessage(link.lastAckType, Protocol.MSG_FAVORITES, "ACK of 0x05");
        Test.assertEqualMessage(assembler.chunksReceived, 0, "does not count as a route chunk");
        Test.assertMessage(FavoritesAssert.logged("favorites 3 applied"), "the log line of the applied one");

        FavoritesAssert.done();
        return true;
    }

    //! The incoming list **replaces** the previous one: the phone sends the whole list on
    //! every change, so a favorite deleted there must disappear here.
    // prevents: a favorite deleted on the phone staying on the watch screen (a list that only adds).
    (:test)
    function aNewListReplacesTheWholeOldOne(logger as Logger) as Boolean {
        var link = new FakeLink();
        var assembler = FavoritesAssert.assembler(link);

        assembler.onData(TestVectors.FAVORITES);
        assembler.onData(TestVectors.FAVORITES_REPLACEMENT);

        Test.assertEqualMessage(Favorites.count(), 1, "only the new one");
        Test.assertEqualMessage(Favorites.ids[0], TestVectors.FAV_REPLACEMENT_ID, "favId");
        Test.assertEqualMessage(Favorites.names[0], TestVectors.FAV_REPLACEMENT_NAME, "nome");
        Test.assertEqualMessage(Favorites.indexOfId(TestVectors.FAV_IDS[0]), -1, "the old one is gone");

        // `count = 0` empties it.
        assembler.onData(TestVectors.FAVORITES_EMPTY);
        Test.assertEqualMessage(Favorites.count(), 0, "an empty list empties");
        Test.assertEqualMessage(link.ackCount, 3, "one ACK per message");

        FavoritesAssert.done();
        return true;
    }

    //! The messages the watch rejects whole (`05 §FAVORITES`): the list that was already
    //! there **stays**, the ACK goes out (it is transport) and the reason goes to the log.
    // prevents: a corrupted message erasing or half-applying the list that worked — Igor
    // would be left without favorites on the street over one bad BLE chunk.
    (:test)
    function aRefusedMessageKeepsTheOldList(logger as Logger) as Boolean {
        var refused = [
            TestVectors.FAVORITES_TOO_MANY,
            TestVectors.FAVORITES_DUPLICATE_ID,
            TestVectors.FAVORITES_TRUNCATED,
            TestVectors.FAVORITES_NAME_TOO_LONG,
            TestVectors.FAVORITES_TRAILING_BYTE
        ] as Array<ByteArray>;
        var why = ["more than 6", "favId repeated", "short payload", "name over 20", "extra bytes"];

        for (var i = 0; i < refused.size(); i++) {
            var link = new FakeLink();
            var assembler = FavoritesAssert.assembler(link);
            assembler.onData(TestVectors.FAVORITES);

            assembler.onData(refused[i]);

            FavoritesAssert.assertIsTheFixture();
            Test.assertEqualMessage(link.ackCount, 2, why[i] + ": the ACK always goes out");
            Test.assertMessage(FavoritesAssert.logged("favorites refused: " + why[i]), why[i] + ": the reason in the log");
        }

        FavoritesAssert.done();
        return true;
    }

    //! Six is the cap and it fits: three one-letter items with `count` 3 go through.
    // prevents: the cap of 6 becoming "less than 6" through a limit error (off-by-one rejecting the full list).
    (:test)
    function exactlyThreeShortItemsAreAccepted(logger as Logger) as Boolean {
        var link = new FakeLink();
        var assembler = FavoritesAssert.assembler(link);

        assembler.onData(TestVectors.FAVORITES_THREE_SHORT);

        Test.assertEqualMessage(Favorites.count(), 3, "the three");
        Test.assertEqualMessage(Favorites.names[2], "C", "the last one");
        FavoritesAssert.done();
        return true;
    }

    //! The list survives the app closing: the Favorites screen works before the
    //! phone speaks (`restore` on open).
    // prevents: opening the app on the watch without the phone nearby and finding the favorites list empty.
    (:test)
    function theListComesBackFromStorage(logger as Logger) as Boolean {
        var link = new FakeLink();
        Favorites.reset(true);
        var assembler = new MessageAssembler(new RouteModel(), link);
        try {
            assembler.onData(TestVectors.FAVORITES);
            Favorites.reset(false);
            Test.assertEqualMessage(Favorites.count(), 0, "cleared in memory");

            Favorites.restore();

            FavoritesAssert.assertIsTheFixture();
            Test.assertMessage(FavoritesAssert.logged("favorites restored from Storage: 3"), "the log line");
        } finally {
            Favorites.reset(true);
            Diag.clear();
        }
        return true;
    }

    //! The NAV_START_REQ frame must be, byte by byte, the one from `tools/packer.py`
    //! (`nav_start_req_00.bin`), which is what the Kotlin reader checks on the other side.
    // prevents: the phone receiving the favId at the wrong offset and routing to another favorite.
    (:test)
    function navStartReqMatchesTheFixture(logger as Logger) as Boolean {
        var frame = new PhoneLink().navStartReqFrame(TestVectors.NAV_START_FAV_ID);
        var expected = TestVectors.NAV_START_REQ;

        Test.assertEqualMessage(frame.size(), expected.size(), "frame size");
        for (var i = 0; i < expected.size(); i++) {
            Test.assertEqualMessage(frame[i], expected[i], "byte " + i.toString());
        }
        return true;
    }

    //! The pending request: after 20 s with no route the watch says the phone did not
    //! answer; when the route arrives (or on cancel) the message goes away.
    // prevents: "Pedindo rota…" (Requesting route…) on the screen forever when the phone is off.
    (:test)
    function theAskTimesOutAndClears(logger as Logger) as Boolean {
        var ask = new FavoriteAsk();
        Test.assertEqualMessage(ask.text(), "", "idle says nothing");

        ask.start(2, "MASP", 1000);
        Test.assertMessage(ask.text().find("MASP") != null, "asking: " + ask.text());
        Test.assertMessage(!ask.update(1000 + FavoriteAsk.TIMEOUT_MS - 1), "still within the deadline");
        Test.assertMessage(ask.update(1000 + FavoriteAsk.TIMEOUT_MS), "deadline exceeded");
        Test.assertMessage(ask.text().find("responde") != null, "no reply: " + ask.text());

        ask.clear();
        Test.assertEqualMessage(ask.text(), "", "clear");
        return true;
    }

    //! A half-arrived new route spins the home screen ring (C16, in place of
    //! `DebugView`): with no request, in a nameless wait; with a request, in its own. Each
    //! piece renews the deadline, and amber only comes when the route stopped arriving.
    // prevents: the F1 numbers on the screen for 3 s on every route (trips of 2026-10-20).
    (:test)
    function aRouteChunkSpinsTheRingUntilItStops(logger as Logger) as Boolean {
        var ask = new FavoriteAsk();
        ask.noteRouteChunk(1000);
        Test.assertMessage(ask.isWaiting(), "the phone share also spins the ring");
        Test.assertEqualMessage(ask.text(), "Recebendo rota", "unnamed wait");

        ask.noteRouteChunk(15000);
        Test.assertMessage(!ask.update(1000 + FavoriteAsk.TIMEOUT_MS), "the new piece renewed the deadline");
        Test.assertMessage(ask.update(15000 + FavoriteAsk.TIMEOUT_MS), "the route stopped arriving");
        Test.assertMessage(ask.isSilent(), "then the amber");
        Test.assertEqualMessage(ask.text(), "A rota parou de chegar", "the watch asked for nothing");

        ask.clear();
        ask.start(2, "MASP", 0);
        ask.noteRouteChunk(3000);
        Test.assertMessage(ask.text().find("MASP") != null, "the route is the answer to the favorite: " + ask.text());
        Test.assertMessage(!ask.isShared(), "and it does not become an unnamed wait");
        ask.clear();
        Test.assertMessage(!ask.isWaiting(), "showNav clears it");
        return true;
    }

}
