import Toybox.Application.Storage;
import Toybox.Graphics;
import Toybox.Lang;
import Toybox.Test;

//! **The CONFIG message** (C5, `05 §CONFIG`): fine tuning without a cable.
//!
//! The bytes come from `TestVectors`, generated by `tools/gen_watch_test_vectors.py`;
//! the `CONFIG` there is **`tools/fixtures/config_00.bin` itself**, the same
//! file the Kotlin `configMatchesFixture` compares the packer against.
//!
//! Every test enters and leaves with `Config` at the default and without writing to `Storage`
//! (`persistConfig = false`): the simulator `Storage` survives between runs
//! (measured in C5), and a forgotten setting here would change the `sim.py ride` lap.
(:test)
module ConfigAssert {

    //! Assembler with no route, with the fake link and without writing to `Storage`.
    function assembler(link as FakeLink) as MessageAssembler {
        Config.reset(false);
        Diag.clear();
        var assembler = new MessageAssembler(new RouteModel(), link);
        assembler.persistConfig = false;
        return assembler;
    }

    //! Does any `Diag` line contain `text`?
    function logged(text as String) as Boolean {
        for (var i = 0; i < Diag.lines.size(); i++) {
            if ((Diag.lines[i] as String).find(text) != null) {
                return true;
            }
        }
        return false;
    }

    function atDefaults() as Boolean {
        for (var i = 0; i < Config.KEY_COUNT; i++) {
            if ((Config.values[i] as Number) != (Config.DEFAULTS[i] as Number)) {
                return false;
            }
        }
        return true;
    }

    function done() as Void {
        Config.reset(false);
        Diag.clear();
    }
}

//! The packer.py `config_00.bin` applies the 16 keys with the `CONFIG_SAMPLE`
//! values, **with no route at all on the watch** (outside the route/META
//! check), with an ACK of type 0x09 and without touching the route or its timer.
(:test)
function parsesTheFixture(logger as Logger) as Boolean {
    var link = new FakeLink();
    var assembler = ConfigAssert.assembler(link);

    assembler.onData(TestVectors.CONFIG);

    Test.assertMessage(assembler.lastWasConfig, "the app needs to know it was a CONFIG");
    Test.assertEqualMessage(Config.values[Config.KEY_LEAD_S - 1], TestVectors.CONFIG_LEAD_S, "lead_s");
    Test.assertEqualMessage(Config.values[Config.KEY_LEAD_MIN_M - 1], TestVectors.CONFIG_LEAD_MIN_M, "lead_min_m");
    Test.assertEqualMessage(Config.values[Config.KEY_NEAR_M - 1], TestVectors.CONFIG_NEAR_M, "near_m");
    Test.assertEqualMessage(Config.values[Config.KEY_PULSE_MS - 1], TestVectors.CONFIG_PULSE_MS, "pulse_ms");
    Test.assertEqualMessage(Config.values[Config.KEY_ZOOM - 1], TestVectors.CONFIG_ZOOM, "zoom");
    Test.assertEqualMessage(Config.values[Config.KEY_CORRIDOR_PCT - 1], TestVectors.CONFIG_CORRIDOR_PCT, "corridor_pct");
    Test.assertEqualMessage(Config.values[Config.KEY_HUD_PCT - 1], TestVectors.CONFIG_HUD_PCT, "hud_pct");
    Test.assertEqualMessage(Config.values[Config.KEY_ORBIT_PX - 1], TestVectors.CONFIG_ORBIT_PX, "orbit_px");
    Test.assertEqualMessage(Config.values[Config.KEY_ORBIT_S - 1], TestVectors.CONFIG_ORBIT_S, "orbit_s");
    Test.assertEqualMessage(Config.values[Config.KEY_DIST_PCT - 1], TestVectors.CONFIG_DIST_PCT, "dist_pct");
    Test.assertEqualMessage(Config.values[Config.KEY_ETA_PCT - 1], TestVectors.CONFIG_ETA_PCT, "eta_pct");
    Test.assertEqualMessage(Config.values[Config.KEY_TEXT_PCT - 1], TestVectors.CONFIG_TEXT_PCT, "text_pct");
    Test.assertEqualMessage(Config.values[Config.KEY_ARROW_PCT - 1], TestVectors.CONFIG_ARROW_PCT, "arrow_pct");
    Test.assertEqualMessage(Config.values[Config.KEY_PLATE_W_PCT - 1], TestVectors.CONFIG_PLATE_W_PCT, "plate_w_pct");
    Test.assertEqualMessage(Config.values[Config.KEY_PLATE_H_PCT - 1], TestVectors.CONFIG_PLATE_H_PCT, "plate_h_pct");
    Test.assertEqualMessage(Config.values[Config.KEY_GPS_DRILL_MIN - 1], TestVectors.CONFIG_GPS_DRILL_MIN, "gps_drill_min");
    Test.assertEqualMessage(Config.values[Config.KEY_STREET_IMG - 1], TestVectors.CONFIG_STREET_IMG, "street_img");
    Test.assertEqualMessage(Config.values[Config.KEY_MAP_TILT - 1], TestVectors.CONFIG_MAP_TILT, "map_tilt");
    Test.assertEqualMessage(Config.values[Config.KEY_STREET_16BIT - 1], TestVectors.CONFIG_STREET_16BIT, "street_16bit");
    Test.assertEqualMessage(Config.values[Config.KEY_STREET_DIAG - 1], TestVectors.CONFIG_STREET_DIAG, "street_diag");
    Test.assertEqualMessage(Config.values[Config.KEY_VIBE_ON - 1], TestVectors.CONFIG_VIBE_ON, "vibe_on");
    Test.assertEqualMessage(Config.values[Config.KEY_RADAR_VIBE - 1], TestVectors.CONFIG_RADAR_VIBE, "radar_vibe");
    Test.assertMessage(ConfigAssert.logged("config lead_s=10 lead_min_m=100 near_m=30 pulse_ms=250 zoom=2 corridor_pct=120 hud_pct=95 orbit_px=3 orbit_s=30 dist_pct=80 eta_pct=90 text_pct=70 arrow_pct=85 plate_w_pct=60 plate_h_pct=40 gps_drill_min=8 street_img=0 map_tilt=0 street_16bit=0 street_diag=3 vibe_on=1 radar_vibe=0 applied"),
        "the applied log line");

    // Derived, channel by channel: the express 0x8C7A58 (v1.2.3) x 120% = 0xA8 0x92 0x69
    // (140 -> 168, 122 -> 146, 88 -> 105, truncating).
    Test.assertEqualMessage(Config.corridorColor(0), 0xA89269, "corridor brightness");
    // prevents: the group % and hud_pct no longer multiplying each other (C16.5): 95% x 80% = 76%, and 56 px at 76% = 43.
    Test.assertEqualMessage(Config.groupPct(Config.KEY_DIST_PCT), 76, "effective distance scale");
    Test.assertEqualMessage(Config.groupPx(DesignTokens.DIST_PX, Config.KEY_DIST_PCT), (DesignTokens.DIST_PX * 76 + 50) / 100,
        "distance px at the group scale");

    Test.assertEqualMessage(link.ackCount, 1, "one ACK");
    Test.assertEqualMessage(link.lastAckType, Protocol.MSG_CONFIG, "ACK of 0x09");
    Test.assertEqualMessage(link.lastBitmap[0] as Number, 0x01, "single-chunk bitmap");
    Test.assertEqualMessage(assembler.getRoute().routeId, 0, "did not become a route");
    Test.assertEqualMessage(assembler.transferStartMs, 0, "does not count in the route timer");

    ConfigAssert.done();
    return true;
}

//! Out of range: the whole message is rejected, nothing changes, the line says why
//! — and the ACK goes out anyway (it is transport; the rejection goes through the log).
(:test)
function outOfRangeIsRejected(logger as Logger) as Boolean {
    var link = new FakeLink();
    var assembler = ConfigAssert.assembler(link);
    var revision = Config.revision;

    Test.assertEqualMessage(Config.lastKeys.size(), Config.KEY_COUNT, "the reset brought the 22 keys");
    assembler.onData(TestVectors.CONFIG_OUT_OF_RANGE);

    Test.assertMessage(ConfigAssert.atDefaults(), "nothing changed");
    Test.assertEqualMessage(Config.lastKeys.size(), 0, "refused brings no key (the app leaves the zoom alone)");
    Test.assertEqualMessage(Config.revision, revision, "no new revision");
    Test.assertMessage(ConfigAssert.logged("config refused lead_s=16 outside 4..15"), "the refusal line");
    Test.assertEqualMessage(link.lastAckType, Protocol.MSG_CONFIG, "the ACK goes out even when refused");

    ConfigAssert.done();
    return true;
}

//! The HUD scale **never** leaves text below the legibility floor (13 px,
//! C16.5): a point below the generated floor (`DesignTokens.HUD_SCALE_MIN_PCT`) is
//! rejected with the range line; at the exact floor, no text asks for less than 13 px.
//! RNF-05 (55 px and 20 px) holds at 100%: `Rnf05Test` is what checks it.
// prevents: the rider shrinking the HUD (Igor's request, C16.5) down to text that cannot be read.
(:test)
function hudScaleBelowFloorIsRejected(logger as Logger) as Boolean {
    var link = new FakeLink();
    var assembler = ConfigAssert.assembler(link);

    assembler.onData(TestVectors.CONFIG_HUD_LOW);
    Test.assertEqualMessage(Config.values[Config.KEY_HUD_PCT - 1], 100, "the scale did not change");
    Test.assertMessage(ConfigAssert.logged("config refused hud_pct=" + TestVectors.CONFIG_HUD_LOW_PCT.toString()
        + " outside " + DesignTokens.HUD_SCALE_MIN_PCT.toString() + ".."
        + DesignTokens.HUD_SCALE_MAX_PCT.toString()), "the refusal line");

    assembler.onData(TestVectors.CONFIG_HUD_MIN);
    Test.assertEqualMessage(Config.values[Config.KEY_HUD_PCT - 1], DesignTokens.HUD_SCALE_MIN_PCT, "the floor applies");
    var hud = new Hud();
    hud.prepare(Rnf05Assert.canvas(200));
    logger.debug("at the floor of " + DesignTokens.HUD_SCALE_MIN_PCT.toString() + "%: distance "
        + hud.requestedDistPx().toString() + " px, text " + hud.requestedTextPx().toString() + " px");
    Test.assertMessage(hud.requestedTextPx() >= Rnf05Assert.MIN_FLOOR_TEXT_PX,
        "at the floor the text asks for " + hud.requestedTextPx().toString() + " px");

    ConfigAssert.done();
    return true;
}

//! Applies **without restarting**: an `AlertPolicy` that already existed starts using the
//! new lead time, and the `Hud` rebuilds the fonts on the next revision.
(:test)
function configAppliesWithoutRestart(logger as Logger) as Boolean {
    var link = new FakeLink();
    var assembler = ConfigAssert.assembler(link);
    var policy = new AlertPolicy();
    var hud = new Hud();
    var dc = Rnf05Assert.canvas(200);
    hud.prepare(dc);
    Test.assertMessage(NavAssert.near(policy.leadDistance(28.0), 224.0, 0.1), "8 s at 28 m/s before");
    var before = TurnArrow.scale();

    assembler.onData(TestVectors.CONFIG_LEAD10);
    Test.assertMessage(NavAssert.near(policy.leadDistance(28.0), 280.0, 0.1), "10 s at 28 m/s after");
    Test.assertMessage(ConfigAssert.logged("config lead_s=10 applied"), "the applied line");

    assembler.onData(TestVectors.CONFIG);
    hud.prepare(dc);
    // prevents: a group's scale (C16.5) no longer reaching the drawing. The sample shrinks the arrow
    // (95% x 85%) and the distance (95% x 80%): both must change without restarting.
    Test.assertMessage(TurnArrow.scale() < before, "the arrow shrank with the new scale");
    Test.assertEqualMessage(hud.requestedDistPx(), Config.groupPx(DesignTokens.DIST_PX, Config.KEY_DIST_PCT),
        "the distance font followed the group");
    Test.assertEqualMessage(policy.patternFor(Protocol.TURN_LEFT).size(), 3, "the pulse count does not change");

    ConfigAssert.done();
    return true;
}

//! A repeated key and a close warning outside the minimum lead time reject everything;
//! an unknown key (newer companion) is ignored and the rest applies.
(:test)
function inconsistentConfigIsRejectedWhole(logger as Logger) as Boolean {
    var link = new FakeLink();
    var assembler = ConfigAssert.assembler(link);

    assembler.onData(TestVectors.CONFIG_DUPLICATE);
    Test.assertMessage(ConfigAssert.atDefaults(), "repeated: nothing changed");
    Test.assertMessage(ConfigAssert.logged("config refused lead_s repeated"), "the repeated line");

    assembler.onData(TestVectors.CONFIG_NEAR_OVER_LEAD);
    Test.assertMessage(ConfigAssert.atDefaults(), "near >= minimum: nothing changed");
    Test.assertMessage(ConfigAssert.logged("config refused near_m=50 not lower than lead_min_m=40"), "the near line");

    assembler.onData(TestVectors.CONFIG_UNKNOWN_KEY);
    Test.assertEqualMessage(Config.values[Config.KEY_LEAD_S - 1], 12, "the known key applied");
    Test.assertMessage(ConfigAssert.logged("config key 42 ignored"), "the unknown-key line");

    ConfigAssert.done();
    return true;
}

//! An empty CONFIG returns everything to the default.
(:test)
function emptyConfigResetsToDefaults(logger as Logger) as Boolean {
    var link = new FakeLink();
    var assembler = ConfigAssert.assembler(link);

    assembler.onData(TestVectors.CONFIG);
    Test.assertMessage(!ConfigAssert.atDefaults(), "the sample changed everything");
    assembler.onData(TestVectors.CONFIG_RESET);
    Test.assertMessage(ConfigAssert.atDefaults(), "back to the default");
    Test.assertEqualMessage(Config.corridorColor(0), MapRenderer.LOD_COLOR[0] as Number, "gray back at 100%");
    Test.assertMessage(ConfigAssert.logged("config default applied"), "the default line");

    ConfigAssert.done();
    return true;
}

//! Writes to `Storage` and the next opening's [Config.restore] returns it, with the
//! line `sim.py demo --reabrir` looks for. Clears `Storage` at the end.
(:test)
function storedConfigIsRestored(logger as Logger) as Boolean {
    ConfigAssert.done();
    var lead10 = TestVectors.CONFIG_LEAD10;
    Test.assertMessage(Config.applyPayload(lead10.slice(Protocol.HEADER_SIZE, null), true), "applied and saved");

    Config.reset(false);  // "closed the app": memory goes back to the default, Storage does not
    Test.assertMessage(ConfigAssert.atDefaults(), "memory at the default");
    Config.restore();
    Test.assertEqualMessage(Config.values[Config.KEY_LEAD_S - 1], 10, "restored lead_s");
    Test.assertMessage(ConfigAssert.logged("config lead_s=10 restored from Storage"), "the restored line");

    Storage.deleteValue(Config.STORAGE_KEY);
    ConfigAssert.done();
    return true;
}
