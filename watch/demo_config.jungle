# Fine adjustment with no cable (C5): `monkeyc -f "monkey.jungle;demo.jungle;demo_config.jungle"`,
# only through `tools/sim.py demo --config` or `--rota-longa` (C6a). It is the demo with the
# messages of `bin/config/ConfigParams.mc` (generated by `sim.py` on every run) in
# place of the empty `demoPreludeFrames` of `demo/source/DemoConfigNone.mc` (annotated
# `no_demo_config`).
base.sourcePath = source;demo/source;bin/config
base.resourcePath = resources;demo/resources
base.excludeAnnotations = canary;quadratic_parse;nodemo;no_near_alert;no_demo_config
